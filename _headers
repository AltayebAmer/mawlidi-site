# Cloudflare Pages Headers
# mawlidi.com v2

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()

# الجذر: كان حتى وقت قريب هو الموقع القديم كاملاً (ملف 172KB)، فنسخة قديمة
# منه بقيت في ذاكرة بعض المتصفحات وتُعرض بدل التحويل. بلا هذه القاعدة كان /
# يرث الافتراضي ولا يُراجَع.
/
  Cache-Control: no-store, must-revalidate

/index.html
  Cache-Control: no-store, must-revalidate

# صفحات HTML: لا تُخزَّن مؤقتاً — وإلا لم يرَ الزائر أي نشر جديد قبل ساعة
/arb/*
  Content-Language: ar
  Cache-Control: public, max-age=0, must-revalidate

/eng/*
  Content-Language: en
  Cache-Control: public, max-age=0, must-revalidate

# أسماء الأصول ثابتة لا تحمل بصمة محتوى، فالتخزين الطويل بلا مراجعة
# يعني أن إصلاحاً منشوراً لا يصل من حمّل النسخة القديمة
/assets/*
  Cache-Control: public, max-age=86400, must-revalidate

/sitemap.xml
  Cache-Control: public, max-age=3600
